# Copy to .env.local and fill in. .env.local is git-ignored: never commit real keys.
# A free GEMINI_API_KEY (below) runs the full agent; with no key at all, FollowThru runs in demo mode.
ANTHROPIC_API_KEY=

# Optional: model override (default claude-opus-5-5) and timezone for resolving "next Thursday"
FOLLOWTHRU_MODEL=claude-opus-5-5
FOLLOWTHRU_TZ=Asia/Kolkata

# Optional: Notion. Create an internal integration at notion.so/my-integrations,
# share one page with it, and paste that page's ID here. Docs and tasks become child pages.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Optional: GitHub Issues as the task tracker (fine-grained token with Issues: write)
GITHUB_TOKEN=
GITHUB_REPO=owner/name

# SQLite file (local). For hosted deploys use a Turso URL + DATABASE_AUTH_TOKEN.
DATABASE_URL=file:data/followthru.db

# Free alternative to Claude: Google Gemini free tier (https://aistudio.google.com/apikey).
# Any OpenAI-compatible provider works too: set LLM_BASE_URL + LLM_API_KEY + LLM_MODEL (e.g. Groq's free tier).
GEMINI_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Zoom: webhook secret token from your Zoom Marketplace app (Event Subscriptions)
ZOOM_WEBHOOK_SECRET_TOKEN=
